{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "*": [
        "addon/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "addon/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}